    {
      "name": "snapshot-fullsize",
      "description": "Experiment for snapshot-aware indexing-tier autoscaling (not for merge). Indexes the corpus several times into one single-shard index so it grows past the real auto-reshard threshold, with the usual SLM schedule, so the catch-up snapshot after the split happens as it would in production.",
      "schedule": [
        {% if not (fullsize_keep_index | default(false)) %}
        {
          "operation": "delete-index"
        },
        {
          "operation": {
            "operation-type": "create-index",
            "index": "nyc_taxis",
            "settings": {
              "index.codec": "best_compression",
              "index.refresh_interval": "30s"
            }
          }
        },
        {% endif %}
        {
          "name": "check-cluster-health",
          "operation": {
            "operation-type": "cluster-health",
            "index": "nyc_taxis",
            "request-params": {
              "wait_for_status": "{{cluster_health | default('green')}}",
              "wait_for_no_relocating_shards": "true"
            },
            "retry-until-success": true
          }
        }{% for pass in range(fullsize_passes | default(4)) %},
        {
          "name": "index-pass-{{pass}}",
          "operation": "index",
          "clients": {{bulk_indexing_clients | default(8)}},
          "ignore-response-error-level": "{{error_level | default('non-fatal')}}"
        }{% endfor %}
      ]
    }
